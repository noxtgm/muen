# Windows
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+q=unbind
keybind = ctrl+enter=unbind
keybind = alt+f4=close_window

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = alt+1=unbind
keybind = alt+digit_1=unbind
keybind = ctrl+1=goto_tab:1
keybind = alt+2=unbind
keybind = alt+digit_2=unbind
keybind = ctrl+2=goto_tab:2
keybind = alt+3=unbind
keybind = alt+digit_3=unbind
keybind = ctrl+3=goto_tab:3
keybind = alt+4=unbind
keybind = alt+digit_4=unbind
keybind = ctrl+4=goto_tab:4
keybind = alt+5=unbind
keybind = alt+digit_5=unbind
keybind = ctrl+5=goto_tab:5
keybind = alt+6=unbind
keybind = alt+digit_6=unbind
keybind = ctrl+6=goto_tab:6
keybind = alt+7=unbind
keybind = alt+digit_7=unbind
keybind = ctrl+7=goto_tab:7
keybind = alt+8=unbind
keybind = alt+digit_8=unbind
keybind = ctrl+8=goto_tab:8
keybind = alt+9=unbind
keybind = ctrl+9=last_tab

# Splits, created with ctrl+alt+arrows and focused with alt+arrows
keybind = ctrl+alt+arrow_up=new_split:up
keybind = ctrl+alt+arrow_down=new_split:down
keybind = ctrl+alt+arrow_left=new_split:left
keybind = ctrl+alt+arrow_right=new_split:right
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = super+ctrl+shift+arrow_up=resize_split:up,10
keybind = super+ctrl+shift+arrow_down=resize_split:down,10
keybind = super+ctrl+shift+arrow_left=resize_split:left,10
keybind = super+ctrl+shift+arrow_right=resize_split:right,10
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = super+ctrl+[=unbind
keybind = super+ctrl+]=unbind
keybind = ctrl+shift+enter=unbind

# Copy and paste
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection

# Scrolling
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1

# Font size
keybind = ctrl+==increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size
keybind = ctrl++=unbind

# Config, command palette and inspector
keybind = ctrl+,=unbind
keybind = ctrl+shift+,=unbind
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+i=unbind

# Screen contents to file
keybind = ctrl+shift+j=unbind
keybind = ctrl+alt+shift+j=unbind
