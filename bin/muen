#!/bin/bash
# TODO: add the correct pipefail

# TODO: add the required paths

source "${REPO_LIB}/colors.sh"
source "${REPO_LIB}/logging.sh"

# TODO: add an error trap

_update() {
    source "${REPO_LIB}/init.sh"
    packages_install
    configs_deploy
    boot_configure
    shell_set_default
    boot_images_rebuild
}

main() {
    if [[ $# -eq 2 && "$1" == 'update' && "$2" == '--force' ]]; then
        FORCE=1
    elif [[ $# -ne 1 || "$1" != 'update' ]]; then
        die "Expected 'muen update' or 'muen update --force'"
    fi

    update
}

main "$@"
